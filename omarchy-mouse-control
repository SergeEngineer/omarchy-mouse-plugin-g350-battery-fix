CONFIG_FILE = os.path.expanduser("~/.config/omarchy/mouse-lighting.json")
STATE_DIR = os.path.expanduser("~/.local/state/omarchy")
COLORS_FILE = os.path.join(STATE_DIR, "current/theme/colors.toml")

DEFAULT_PALETTE = [
    {"slot": "accent", "color": "#7d82d9"},
    {"slot": "red", "color": "#ed5b5a"},
    {"slot": "orange", "color": "#eb8b54"},
    {"slot": "yellow", "color": "#e9bb4f"},
    {"slot": "green", "color": "#92a593"},
    {"slot": "cyan", "color": "#a3bfd1"},
    {"slot": "blue", "color": "#7d82d9"},
    {"slot": "magenta", "color": "#c89dc1"},
]

def load_lighting_config():
    default_config = {
        "enabled": True,
        "mode": "color",
        "color": "#7d82d9",
        "theme_slot": "accent",
        "breathing": False,
        "duration": 8000,
        "brightness": 255
    }
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                data = json.load(f)
                default_config.update(data)
        except Exception:
            pass

    # Normalize modes (migrate legacy "theme" or "custom" to "color")
    if default_config["mode"] in ("theme", "custom"):
        default_config["mode"] = "color"
    if default_config["mode"] not in ("color", "rainbow"):
        default_config["mode"] = "color"

    return default_config

def save_lighting_config(cfg):
    try:
        os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(cfg, f, indent=2)
    except Exception as e:
        print(f"Warning: could not save lighting config: {e}", file=sys.stderr)

def get_theme_palette():
    palette = []
    seen_slots = set()
    target_slots = ["accent", "red", "orange", "yellow", "green", "cyan", "blue", "magenta"]

    if os.path.exists(COLORS_FILE):
        try:
            slot_colors = {}
            with open(COLORS_FILE, "r") as f:
                for line in f:
                    line = line.strip()
                    if "=" in line and "#" in line:
                        k, v = line.split("=", 1)
                        k = k.strip()
                        v = v.split("#")[1].strip().strip("\"'").replace(";", "")
                        hex_code = "#" + v[:6].lower()
                        slot_colors[k] = hex_code

            for slot in target_slots:
                if slot in slot_colors:
                    palette.append({"slot": slot, "color": slot_colors[slot]})
                    seen_slots.add(slot)
        except Exception:
            pass

    if not palette:
        palette = list(DEFAULT_PALETTE)
    return palette

def ratbagctl(*args, retries=RATBAG_RETRIES):
    """Run a ratbagctl command, retrying transient sleep/wake timeouts.

    Returns stdout on success, or None on failure. Never raises.
    """
    for attempt in range(retries):
        try:
            return subprocess.check_output(
                ["ratbagctl", *args], timeout=RATBAG_TIMEOUT, text=True,
                stderr=subprocess.DEVNULL)
        except Exception:
            if attempt + 1 < retries:
                time.sleep(0.15)
    return None


def find_ratbag_device():
    """Return (dev_id, dev_name), preferring a mouse over other ratbag devices."""
    out = ratbagctl("list")
    if not out:
        return None, None

    candidates = []
    for line in out.strip().splitlines():
        if ":" not in line:
            continue
        dev_id, dev_name = line.split(":", 1)
        dev_id, dev_name = dev_id.strip(), dev_name.strip()
        if dev_id:
            candidates.append((dev_id, dev_name))

    if not candidates:
        return None, None

    # If more than one libratbag device is present (keyboard + mouse, for
    # example), do not blindly control the first one in the list.
    mouse_words = re.compile(r"mouse|logitech|g\s?pro|g\s?\d{3}", re.I)
    for dev_id, dev_name in candidates:
        if mouse_words.search(dev_name):
            return dev_id, dev_name
    return candidates[0]


def ratbagctl_int(*args):
    """Read a single integer from a ratbagctl command, or None if unavailable."""
    out = ratbagctl(*args)
    if out is None:
        return None
    m = re.search(r"\d+", out)
    return int(m.group(0)) if m else None


def ensure_profile_0(dev_id):
    p = ratbagctl(dev_id, "profile", "active", "get", retries=1)
    if p is not None and p.strip() != "0":
        ratbagctl(dev_id, "profile", "active", "set", "0", retries=1)

def apply_lighting():
    cfg = load_lighting_config()
    dev_id, _ = find_ratbag_device()
    if not dev_id:
        return

    ensure_profile_0(dev_id)

    enabled = cfg.get("enabled", True)
    mode = cfg.get("mode", "color")
    bgt = max(0, min(255, int(cfg.get("brightness", 255))))
    dur = max(1000, min(10000, int(cfg.get("duration", 8000))))
    color = cfg.get("color", "#7d82d9").lstrip("#")
    breathing = cfg.get("breathing", False)

    if not enabled:
        try:
            subprocess.call([
                "ratbagctl", dev_id, "profile", "0", "led", "0", "set",
                "mode", "off"
            ], timeout=2.0)
        except Exception:
            pass
        return

    if mode == "rainbow":
        try:
            subprocess.call([
                "ratbagctl", dev_id, "profile", "0", "led", "0", "set",
                "mode", "cycle",
                "duration", str(dur),
                "brightness", str(bgt)
            ], timeout=2.0)
        except Exception:
            pass
    else:
        # mode == "color"
        if breathing:
            try:
                subprocess.call([
                    "ratbagctl", dev_id, "profile", "0", "led", "0", "set",
                    "mode", "breathing",
                    "color", color,
                    "duration", str(dur),
                    "brightness", str(bgt)
                ], timeout=2.0)
            except Exception:
                pass
        else:
            try:
                subprocess.call([
                    "ratbagctl", dev_id, "profile", "0", "led", "0", "set",
                    "mode", "on",
                    "color", color,
                    "brightness", str(bgt)
                ], timeout=2.0)
            except Exception:
                pass

def sync_theme():
    """Sync mouse lighting color if user currently has a theme slot selected."""
    cfg = load_lighting_config()
    if not cfg.get("enabled", True):
        return False
    if cfg.get("mode") != "color":
        return False

    theme_slot = cfg.get("theme_slot")
    if not theme_slot:
        return False

    palette = get_theme_palette()
    matched_color = None
    for item in palette:
        if item.get("slot") == theme_slot:
            matched_color = item.get("color")
            break

    if matched_color:
        cfg["color"] = matched_color
        save_lighting_config(cfg)
        apply_lighting()
        return True
    return False

def get_state():
    data = {
        "connected": False,
        "battery_available": False,
        "name": "Logitech Mouse",
        "battery": -1,
        "battery_status": "Unknown",
        # 0 means "could not read the device", never a real DPI/rate value.
        # The UI keeps its last known value when it sees 0.
        "active_dpi": 0,
        "dpi_available": False,
        "dpis": [400, 800, 1000, 1200, 1600, 3200],
        "active_rate": 0,
        "rate_available": False,
        "rates": [125, 250, 500, 1000],
        "hypr_sensitivity": 0.0,
        "lighting": {
            "enabled": True,
            "mode": "color",
            "color": "#7d82d9",
            "theme_slot": "accent",
            "breathing": False,
            "duration": 8000,
            "brightness": 255,
            "theme_palette": []
        }
    }

    # 2. Hyprland sensitivity
    try:
        out = subprocess.check_output(["hyprctl", "getoption", "input:sensitivity", "-j"], timeout=1)
        j = json.loads(out)
        data["hypr_sensitivity"] = round(j.get("float", 0.0), 2)
    except Exception:
        pass

    # 3. Ratbagctl device info. `connected` reflects actual ratbagd control,
    #    not merely the presence of battery data.
    dev_id, dev_name = find_ratbag_device()
    if dev_id:
        if dev_name:
            data["name"] = dev_name
        data["connected"] = True
        ensure_profile_0(dev_id)

        dpi = ratbagctl_int(dev_id, "profile", "0", "dpi", "get")
        if dpi is not None:
            data["active_dpi"] = dpi
            data["dpi_available"] = True

        rate = ratbagctl_int(dev_id, "profile", "0", "rate", "get")
        if rate is not None:
            data["active_rate"] = rate
            data["rate_available"] = True

        rates_all = ratbagctl(dev_id, "profile", "0", "rate", "get-all", retries=1)
        if rates_all:
            rates_parsed = [int(r) for r in rates_all.split() if r.isdigit()]
            if rates_parsed:
                data["rates"] = rates_parsed

    # Battery (sysfs -> UPower -> Solaar), after ratbag so dev_name is known
    if data["battery"] < 0:
        read_battery(data, dev_name)

    # 4. Lighting state
    cfg = load_lighting_config()
    cfg["theme_palette"] = get_theme_palette()
    data["lighting"] = cfg

    return data

def _write_ratbag_value(dev_id, field, value):
    """Write a hardware setting and verify it by reading it back.

    ratbagctl can exit 0 while a sleeping wireless mouse has silently ignored
    the write. A failed readback is retried once; the caller is told about it
    instead of the UI optimistically showing a value the mouse never accepted.
    """
    cmd = ["ratbagctl", dev_id, "profile", "0", field, "set", str(value)]
    read_cmd = (dev_id, "profile", "0", field, "get")

    def write_once():
        try:
            subprocess.check_call(cmd, timeout=RATBAG_TIMEOUT,
                                  stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL)
            return True
        except Exception:
            return False

    if not write_once():
        return False
    if ratbagctl_int(*read_cmd) == value:
        return True

    # Wake-on-write: give the receiver a moment, then try once more.
    time.sleep(0.3)
    if not write_once():
        return False
    return ratbagctl_int(*read_cmd) == value


def set_dpi(dpi_val):
    try:
        val = int(float(dpi_val))
    except (TypeError, ValueError):
        print("Error: DPI must be a number", file=sys.stderr)
        return False
    if val <= 0:
        return False
    dev_id, _ = find_ratbag_device()
    if not dev_id:
        print("Error: ratbagd cannot see a mouse (is it awake?)", file=sys.stderr)
        return False
    ensure_profile_0(dev_id)
    if not _write_ratbag_value(dev_id, "dpi", val):
        print(f"Error: mouse did not accept DPI {val} (is it awake?)", file=sys.stderr)
        return False
    return True

def set_rate(rate_val):
    try:
        val = int(float(rate_val))
    except (TypeError, ValueError):
        print("Error: rate must be a number", file=sys.stderr)
        return False
    if val <= 0:
        return False
    dev_id, _ = find_ratbag_device()
    if not dev_id:
        print("Error: ratbagd cannot see a mouse (is it awake?)", file=sys.stderr)
        return False
    ensure_profile_0(dev_id)
    if not _write_ratbag_value(dev_id, "rate", val):
        print(f"Error: mouse did not accept report rate {val} Hz", file=sys.stderr)
        return False
    return True

def set_sensitivity(sens_val):
    try:
        sens_float = float(sens_val)
        sens_float = max(-1.0, min(1.0, sens_float))
    except ValueError:
        return False

    try:
        subprocess.check_call(["hyprctl", "eval", f"hl.config({{ input = {{ sensitivity = {sens_float:.2f} }} }})"], timeout=2)
    except Exception as e:
        print(f"Error applying sensitivity to Hyprland: {e}", file=sys.stderr)

    input_lua = os.path.expanduser("~/.config/hypr/input.lua")
    if os.path.exists(input_lua):
        try:
            with open(input_lua, "r") as f:
                content = f.read()
            new_content = re.sub(r"(\bsensitivity\s*=\s*)[-0-9.]+(,?)", rf"\g<1>{sens_float:.2f}\g<2>", content)
            with open(input_lua, "w") as f:
                f.write(new_content)
        except Exception as e:
            print(f"Warning: could not update {input_lua}: {e}", file=sys.stderr)

    return True

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("state", "--json"):
        print(json.dumps(get_state(), indent=2))
    elif sys.argv[1] == "sync-theme":
        updated = sync_theme()
        print("synced" if updated else "noop")
    elif sys.argv[1] == "set-dpi":
        if len(sys.argv) < 3:
            sys.exit(1)
        if not set_dpi(sys.argv[2]):
            sys.exit(1)
        print("ok")
    elif sys.argv[1] == "set-rate":
        if len(sys.argv) < 3:
            sys.exit(1)
        if not set_rate(sys.argv[2]):
            sys.exit(1)
        print("ok")
    elif sys.argv[1] in ("set-sensitivity", "set-sens"):
        if len(sys.argv) < 3:
            sys.exit(1)
        if not set_sensitivity(sys.argv[2]):
            sys.exit(1)
        print("ok")
    elif sys.argv[1] == "set-lighting-toggle":
        cfg = load_lighting_config()
        if len(sys.argv) >= 3:
            val = sys.argv[2] in ("1", "true", "True", "on")
        else:
            val = not cfg.get("enabled", True)
        cfg["enabled"] = val
        save_lighting_config(cfg)
        apply_lighting()
        print("ok")
    elif sys.argv[1] == "set-lighting-mode":
        if len(sys.argv) < 3:
            sys.exit(1)
        mode = sys.argv[2].lower()
        if mode in ("theme", "custom"):
            mode = "color"
        if mode not in ("color", "rainbow", "off"):
            sys.exit(1)
        cfg = load_lighting_config()
        if mode == "off":
            cfg["enabled"] = False
        else:
            cfg["enabled"] = True
            cfg["mode"] = mode
        save_lighting_config(cfg)
        apply_lighting()
        print("ok")
    elif sys.argv[1] == "set-lighting-color":
        if len(sys.argv) < 3:
            sys.exit(1)
        color = sys.argv[2].strip()
        if not color.startswith("#"):
            color = "#" + color
        slot_name = sys.argv[3].strip() if len(sys.argv) >= 4 else ""
        cfg = load_lighting_config()
        cfg["color"] = color
        cfg["theme_slot"] = slot_name
        cfg["enabled"] = True
        cfg["mode"] = "color"
        save_lighting_config(cfg)
        apply_lighting()
        print("ok")
    elif sys.argv[1] == "set-lighting-breathe":
        if len(sys.argv) < 3:
            sys.exit(1)
        breathe = sys.argv[2] in ("1", "true", "True", "on")
        cfg = load_lighting_config()
        cfg["breathing"] = breathe
        cfg["enabled"] = True
        cfg["mode"] = "color"
        save_lighting_config(cfg)
        apply_lighting()
        print("ok")
    elif sys.argv[1] == "set-lighting-brightness":
        if len(sys.argv) < 3:
            sys.exit(1)
        try:
            bgt = int(float(sys.argv[2]))
            bgt = max(0, min(255, bgt))
        except ValueError:
            sys.exit(1)
        cfg = load_lighting_config()
        cfg["brightness"] = bgt
        save_lighting_config(cfg)
        apply_lighting()
        print("ok")
    elif sys.argv[1] in ("set-lighting-duration", "set-duration"):
        if len(sys.argv) < 3:
            sys.exit(1)
        try:
            val = float(sys.argv[2])
            if val <= 20: # specified in seconds
                val = val * 1000
            dur = max(1000, min(10000, int(val)))
        except ValueError:
            sys.exit(1)
        cfg = load_lighting_config()
        cfg["duration"] = dur
        save_lighting_config(cfg)
        apply_lighting()
        print("ok")
    else:
        print(f"Unknown command: {sys.argv[1]}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
